{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "pack": "vite build --outDir ../server/dist",
    "lint": "eslint --ext .ts,.vue src shared"
  },
  "dependencies": {
    "@types/redis": "^2.8.17",
    "buefy": "^3.1.0",
    "core-js": "^3.6.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.43",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.1",
    "sass": "^1.105.1",
    "sass-loader": "^10.5.2",
    "typescript": "^4.9.5",
    "vite": "^7.3.7"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/typescript/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "ecmaFeatures": {
        "jsx": true,
        "modules": true
      }
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "vue/no-unused-components": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
