{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
    "build": "node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js build",
    "pack": "node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js build --dest ../server/dist",
    "lint": "node --openssl-legacy-provider ./node_modules/@vue/cli-service/bin/vue-cli-service.js lint"
  },
  "dependencies": {
    "@types/redis": "^2.8.17",
    "buefy": "^0.8.0",
    "core-js": "^3.6.4",
    "socket.io-client": "^2.3.0",
    "vue": "^2.6.11",
    "vue-class-component": "^7.2.3",
    "vue-flickity": "^1.2.1",
    "vue-property-decorator": "^8.4.1",
    "vue-socket.io": "github:MetinSeylan/Vue-Socket.io",
    "vue-socket.io-extended": "^4.0.1",
    "vuex": "^3.1.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^2.26.0",
    "@typescript-eslint/parser": "^2.26.0",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-plugin-typescript": "~5.0.9",
    "@vue/cli-plugin-vuex": "~5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/eslint-config-typescript": "^5.0.2",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^6.2.2",
    "sass": "^1.105.1",
    "sass-loader": "^10.5.2",
    "typescript": "~3.8.3",
    "vue-cli-plugin-buefy": "^0.3.7",
    "vue-template-compiler": "^2.6.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/typescript/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "ecmaFeatures": {
        "jsx": true,
        "modules": true
      }
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
